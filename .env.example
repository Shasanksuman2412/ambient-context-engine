# Ambient Context Engine — Environment Variables Example
# Copy this file to .env or set environment variables in your system/shell.

# Tesseract OCR Executable Path (Default for Windows)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Ollama API Configuration (Default localhost)
OLLAMA_BASE_URL=http://localhost:11434

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
